import flixel.FlxG;
import flixel.FlxSprite;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.math.FlxMath;
import funkin.Conductor;
import funkin.play.stage.Stage;
import funkin.play.PlayState;
import flixel.addons.display.FlxBackdrop;
import flixel.addons.display.FlxRuntimeShader;
import openfl.utils.Assets;

class TralalaStage extends Stage 
{
    function new()
    {
        super('tralalaStage');
    }

    var waterShader:WaterShader;
    var waterStartY:Float = 0;
    var clouds:FlxBackdrop;
    function buildStage()
    {
        super.buildStage();

        clouds = new FlxBackdrop(Paths.image('stages/tralala/clouds'), FlxBackdrop.X, -300, 1000);
        clouds.zIndex = 25;
        clouds.x = -1201;
        clouds.y = -791;
        clouds.scale.set(1.2, 1.2);
        clouds.scrollFactor.set(0.15, 0.15);
        clouds.velocity.set(30, 0);
        clouds.antialiasing = true;
        PlayState.instance.currentStage.add(clouds);

        waterShader = new WaterShader();
        waterShader.iTime = 0;
        getNamedProp("Water").shader = waterShader;

        waterStartY = getNamedProp("Water").y;
        doWaterTween(false);
    } 

    var isLeft:Bool = false;
    function doWaterTween(_isLeft:Bool = false)
    {
        isLeft = _isLeft;
        var targetX:Float = isLeft ? getNamedProp("Water").x - 100 : getNamedProp("Water").x + 100;
        FlxTween.tween(getNamedProp("Water"), {x: targetX}, 3, {type: FlxTween.PINGPONG, ease: FlxEase.quadInOut, onComplete: function(twn:FlxTween)
        {
            doWaterTween(!isLeft);
        }});
    }

    var angleSpeed = 15;
    var floatAmplitude = 5;
    var floatSpeed = 1;
    var shaderTime = 0;
    function onUpdate()
    {
        //if(waterShader != null) waterShader.iTime += FlxG.elapsed;
        shaderTime += FlxG.elapsed;
        waterShader.setTime(shaderTime);

        var currentAngle = getNamedProp("Sun").angle;
        getNamedProp("Sun").angle = currentAngle + angleSpeed * FlxG.elapsed;

        var offsetY = Math.sin(Conductor.instance.songPosition * floatSpeed * FlxMath.PI * 2) * floatAmplitude;
        getNamedProp("Water").y = waterStartY + offsetY;
    }
}

class WaterShader extends FlxRuntimeShader
{
    public var iTime:Float = 0;
    public function new()
    {
        super(Assets.getText(Paths.frag("waterShader")));
        setTime(0);
    }

    public function setTime(value:Float):Float
    {
        this.setFloat("iTime", value);
        return iTime = value;
    }
}