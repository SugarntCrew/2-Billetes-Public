import flixel.FlxG;
import flixel.FlxSprite;
import flixel.tweens.FlxTween;
import flixel.addons.display.FlxBackdrop;
import flixel.tweens.FlxEase;
import flixel.math.FlxMath;
import funkin.Conductor;
import funkin.play.PlayState;
import funkin.play.stage.Stage;
import openfl.utils.Assets;
import flixel.util.FlxTimer;

class SnowluiStage extends Stage 
{
    function new()
    {
        super('snowluiStage', 0);
    }

    var walkingMadera:FlxSprite;
    var walkingGbv:FlxSprite;
    var walkingLua:FlxSprite;
    var walkingCloudy:FlxSprite;

    var timers:Array<FlxTimer> = [];
    var tweens:Array<FlxTween> = [];

    function buildStage()
    {
        super.buildStage();

        walkingMadera = new FlxSprite(3200, 250);
        walkingMadera.loadGraphic(Paths.image('stages/snowluibg/madera'));
        walkingMadera.antialiasing = true;
        walkingMadera.scrollFactor.set(1.1, 1.1);
        walkingMadera.zIndex = 500;
        PlayState.instance.currentStage.add(walkingMadera);

        walkingGbv = new FlxSprite(3200, 250);
        walkingGbv.loadGraphic(Paths.image('stages/snowluibg/gbv'));
        walkingGbv.antialiasing = true;
        walkingGbv.scrollFactor.set(1.1, 1.1);
        walkingGbv.zIndex = 500;
        PlayState.instance.currentStage.add(walkingGbv);

        walkingLua = new FlxSprite(3200, 250);
        walkingLua.loadGraphic(Paths.image('stages/snowluibg/lua'));
        walkingLua.antialiasing = true;
        walkingLua.scrollFactor.set(1.1, 1.1);
        walkingLua.zIndex = 500;
        PlayState.instance.currentStage.add(walkingLua);

        walkingCloudy = new FlxSprite(3200, 250);
        walkingCloudy.loadGraphic(Paths.image('stages/snowluibg/cloudy'));
        walkingCloudy.antialiasing = true;
        walkingCloudy.scrollFactor.set(1.1, 1.1);
        walkingCloudy.zIndex = 500;
        PlayState.instance.currentStage.add(walkingCloudy);
    }

    function startTimers()
    {
        FlxTween.cancelTweensOf(walkingMadera);
        FlxTween.cancelTweensOf(walkingGbv);
        FlxTween.cancelTweensOf(walkingLua);
        FlxTween.cancelTweensOf(walkingCloudy);

        walkingMadera.x = 3200;
        walkingGbv.x = 3200;
        walkingLua.x = 3200;
        walkingCloudy.x = 3200;

        walkingMadera.y = 250;
        walkingGbv.y = 250;
        walkingLua.y = 250;
        walkingCloudy.y = 250;

        timers.push(new FlxTimer().start(FlxG.random.float(12, 25), function()
        {
            tweens.push(FlxTween.tween(walkingGbv, {x: -2400}, FlxG.random.float(8, 12)));
        }));

        timers.push(new FlxTimer().start(FlxG.random.float(30, 45), function()
        {
            tweens.push(FlxTween.tween(walkingLua, {x: -2400}, FlxG.random.float(8, 12)));
        }));

        timers.push(new FlxTimer().start(FlxG.random.float(50, 65), function()
        {
            tweens.push(FlxTween.tween(walkingCloudy, {x: -2400}, FlxG.random.float(8, 12)));
        }));

        timers.push(new FlxTimer().start(FlxG.random.float(70, 75), function()
        {
            tweens.push(FlxTween.tween(walkingMadera, {x: -2400}, FlxG.random.float(8, 12)));
        }));

        FlxTween.tween(walkingMadera, {y: walkingMadera.y + 30}, 1.3, {ease: FlxEase.smoothStepInOut, type: 4});
        FlxTween.tween(walkingGbv, {y: walkingGbv.y + 30}, 1.3, {ease: FlxEase.smoothStepInOut, type: 4});
        FlxTween.tween(walkingLua, {y: walkingLua.y + 30}, 1.3, {ease: FlxEase.smoothStepInOut, type: 4});
        FlxTween.tween(walkingCloudy, {y: walkingCloudy.y + 30}, 1.3, {ease: FlxEase.smoothStepInOut, type: 4});
    }

    override function onPause(event)
    {
        super.onPause(event);

        for(tween in tweens) tween.active = false;
        for(timer in timers) timer.active = false;
    }

    override function onResume(event)
    {
        super.onResume(event);

        for(tween in tweens) tween.active = true;
        for(timer in timers) timer.active = true;
    }

    override function onSongStart(event)
    {
        super.onSongStart(event);

        startTimers();
    }
    
    override function onSongRetry(event)
    {
        super.onSongRetry();

        for(timer in timers)
        {
            timer.cancel();
            timers.remove(timer);
        }

        startTimers();
    }

    function onBeatHit(event)
    {
        if(event.beat % 2 == 0)
        {
            getNamedProp("HeroSaturn").animation.play('idle', true);
            getNamedProp("EliAnima").animation.play('idle', true);
            getNamedProp("JabaInk").animation.play('idle', true);
            getNamedProp("Idiots").animation.play('idle', true);
            getNamedProp("Flash").animation.play('idle', true);
        }
    }
}