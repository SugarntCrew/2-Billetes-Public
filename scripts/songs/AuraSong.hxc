import flixel.FlxG;
import flixel.tweens.FlxEase;
import funkin.play.song.Song;
import funkin.play.PlayState;
import funkin.ui.FullScreenScaleMode;

class AuraSong extends Song 
{
    public function new() 
    {
        super('aura', 0);
    }

    var initSpotX:Float = 600;
    var initSpotY:Float = -2800;

    function onCreate()
    {
        trace(FullScreenScaleMode.wideScale.x);
        var extraWidth = FlxG.initialWidth * (FullScreenScaleMode.wideScale.x);
        trace(extraWidth);
        var offset = extraWidth * 0.5;
        trace(offset);
        PlayState.instance.cameraFollowPoint.x = initSpotX - offset; //idk man, offset for mobile lmao
        trace(initSpotX - offset);
        PlayState.instance.cameraFollowPoint.y = initSpotY;
    }

    function onSongRetry()
    {
        //var ease:Null<Float->Float> = Reflect.field(FlxEase, 'quartOut');
        var ease:Null<Float->Float> = FlxEase["quartOut"];
        PlayState.instance.tweenCameraToPosition(initSpotX, initSpotY, 1, ease);
        PlayState.instance.tweenCameraZoom(1.55, 1, false, ease);
        //PlayState.instance.cameraFollowPoint.x = initSpotX;
        //PlayState.instance.cameraFollowPoint.y = initSpotY;
    }
}