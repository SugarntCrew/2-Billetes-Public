import funkin.play.song.Song;
import funkin.play.Countdown;
import funkin.play.PlayState;
import funkin.Paths;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.util.FlxTimer;
import flixel.text.FlxText;
import flixel.addons.text.FlxTypeText;
import flixel.addons.display.FlxRuntimeShader;
import openfl.filters.ShaderFilter;

class SkipCountdown extends Song
{
    public function new() 
    {
        super('fucklua');
    }

    var blackScreen:FlxSprite;
    var luaScriptsText:FlxTypedText;
    var loadingThingiesText:FlxText;
    var ctrShaderThing:FlxSprite;
    var loadingArray:Array = 
    [
        'Starting PlayState...',
        'Setting up BPM Map...',
        'Loading SONG metadata...',
        'Loading stage...',
        'Loading cameras...',
        'Successfully loaded madera.hxc!',
        'Successfully loaded lua.hxc!',
        'Positioning characters...',
        'Loading HUD elements...',
        'Placing strumlines...',
        'Setting up Input System...',
        'Successfully loaded inst and vocals of "Fucklua"',
        'Starting song...'
    ];

    var crtShader:CRTShader;
    var crtFilter:ShaderFilter;

    override function onSongLoaded()
    {
        if(blackScreen != null)
        {
            blackScreen.kill();
            blackScreen = null;
        }

        blackScreen = new FlxSprite();
        blackScreen.makeGraphic(FlxG.width, FlxG.height, 0xFF000000);
        blackScreen.cameras = [PlayState.instance.camHUD];
        blackScreen.zIndex = 9999;
        PlayState.instance.add(blackScreen);

        if(luaScriptsText != null)
        {
            luaScriptsText.kill();
            luaScriptsText = null;
        }

        luaScriptsText = new FlxTypeText(0, 0, 0, '', 26);
        luaScriptsText.font = "assets/fonts/vcr.ttf";
        luaScriptsText.cameras = [PlayState.instance.camHUD];
        luaScriptsText.zIndex = 10000;
		luaScriptsText.shadowOffset.set(0, 0);
		luaScriptsText.antialiasing = true;
        luaScriptsText.color = 0xFF1663B5;
        PlayState.instance.add(luaScriptsText);

        if(loadingThingiesText != null)
        {
            loadingThingiesText.kill();
            loadingThingiesText = null;
        }

        loadingThingiesText = new FlxText(0, 0, 0, '', 18);
        loadingThingiesText.setFormat(Paths.font('vcr.ttf'), 18, 0xFF104885, 'center');
        loadingThingiesText.cameras = [PlayState.instance.camHUD];
        loadingThingiesText.zIndex = 10000;
		loadingThingiesText.antialiasing = true;
        PlayState.instance.add(loadingThingiesText);

        if(ctrShaderThing != null)
        {
            ctrShaderThing.kill();
            ctrShaderThing = null;
        }

        ctrShaderThing = new FlxSprite();
        ctrShaderThing.loadGraphic(Paths.image('stages/fucklua/events/ctrShaderThing'));
        ctrShaderThing.cameras = [PlayState.instance.camHUD];
        ctrShaderThing.screenCenter();
        ctrShaderThing.zIndex = 9999;
        PlayState.instance.add(ctrShaderThing);

        // start text
        new FlxTimer().start(1, function(tmr:FlxTimer)
        {
		    luaScriptsText.resetText('Initializing .lua scripts...');
		    luaScriptsText.start(0.05, true);
            luaScriptsText.completeCallback = function()
            {
                var numLoops = loadingArray.length;

                FlxTimer.loop(0.4, function(loop:Int)
                {
                    loadingThingiesText.text = loadingArray[loop-1];
                    loadingThingiesText.screenCenter();
                    loadingThingiesText.y = luaScriptsText.y + luaScriptsText.height + 10;
                }, numLoops);
            }
        });

        // shader
        crtShader = new CRTShader();
        crtFilter = new ShaderFilter(crtShader);

        if(PlayState.instance.camHUD.filters == null) PlayState.instance.camHUD.filters = [];
        PlayState.instance.camHUD.filters.push(crtFilter);

        PlayState.instance.refresh();
    }

    override function onSongRetry()
    {
        PlayState.instance.camHUD.filters.remove(crtFilter);
        FlxTimer.globalManager.completeAll();
    }

    override function onUpdate()
    {
        luaScriptsText.screenCenter();
    }

    override function onCountdownStart(event):Void
    {
        super.onCountdownStart(event);
        
        event.cancel();
		event.stopPropagation();
        PlayState.instance.isInCountdown = true;
        PlayState.instance.startSong();
    }

    override function onStepHit(event)
    {
        super.onStepHit(event);
        switch(event.step)
        {
            case 64:
                blackScreen.visible = false;
                luaScriptsText.visible = false;
                loadingThingiesText.visible = false;
                ctrShaderThing.visible = false;

                PlayState.instance.camHUD.filters.remove(crtFilter);
        }
    }
}

class CRTShader extends FlxRuntimeShader
{
    public var iTime:Float = 0;
    public function new()
    {
        super(Assets.getText(Paths.frag("crt")));
        setTime(0);
    }

    public function setTime(value:Float):Float
    {
        this.setFloat("iTime", value);
        return iTime = value;
    }
}