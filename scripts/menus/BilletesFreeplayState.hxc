package billetes.menus;

import funkin.modding.module.Module;
import funkin.ui.ScriptedMusicBeatState;
import funkin.ui.freeplay.FreeplayState;
import funkin.play.PlayStatePlaylist;
import funkin.data.song.SongRegistry;
import funkin.play.song.Song;
import funkin.Paths;
import funkin.Preferences;
import funkin.util.Constants;
import funkin.ui.transition.LoadingState;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.addons.display.FlxBackdrop;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.text.FlxText;
import flixel.text.FlxBitmapText;
import flixel.text.FlxTextBorderStyle;
import flixel.util.FlxColor;
import flixel.math.FlxPoint;
import flixel.math.FlxMath;
import flixel.util.FlxTimer;
import flixel.group.FlxTypedGroup;
import flixel.graphics.frames.FlxBitmapFont;
import funkin.util.TouchUtil;
import funkin.util.SwipeUtil;
import funkin.ui.transition.stickers.StickerSubState;
import funkin.modding.module.ModuleHandler;
import funkin.save.Save;
import flixel.util.FlxAxes;

class BilletesFreeplayState extends ScriptedMusicBeatState
{
    var paperBg:FlxSprite;
    var gradient:FlxSprite;
    var scoreBg:FlxSprite;
    var songStuffTxt:FlxText;
    var difficultySpr:FlxSprite;
    var albumSpr:FlxSprite;
    var albumTxt:FlxSprite;
    var freeplaySongsArr:Array<Dynamic> = [
        ['tralala', 'gBv2209'],
        ['bruh', 'gBv2209'],
        ['aura', 'EliAnima'],
        ['chabal', 'ItsTapiii'],
        ['respect', 'ItsTapiii'],
        ['fucklua', 'Mr. Madera'],
        ['pisha', '.'],
        ['maderistic', 'gBv2209']
    ];
    var difficultiesList:Array<String> = [
        'easy',
        'normal',
        'hard',
        'monedas',
        'billetes'
    ];
    var upArrow:FlxSprite;
    var downArrow:FlxSprite;
    var polo:FlxSprite;

    var freeplaySongsGrp:FlxTypedGroup;
    var stickerSubState:StickerSubState = null;

    public function new(?sticker:StickerSubState = null)
    {
        stickerSubState = sticker;
        super("BilletesFreeplayState");
    }

    override function create()
    {
        super.create();

        var handler = ModuleHandler.getModule('BilletesHandler');
        if(handler != null)
        {
            trace('Setting handler varaible to ${handler.onForcedStickerTransition}');
            handler.onForcedStickerTransition = false;
            trace('Setting handler varaible to ${handler.onForcedStickerTransition}');
        }

        FlxG.mouse.visible = true;

        paperBg = new FlxSprite();
        paperBg.frames = Paths.getSparrowAtlas('menus/freeplay/paPER');
        paperBg.animation.addByPrefix('idle', 'papa');
        paperBg.animation.play('idle');
        paperBg.x = FlxG.width - paperBg.width;
        paperBg.antialiasing = true;
        add(paperBg);

        gradient = new FlxSprite();
        gradient.loadGraphic(Paths.image('menus/freeplay/gradient'));
        gradient.x = FlxG.width - gradient.width;
        gradient.antialiasing = true;
        add(gradient);

        scoreBg = new FlxSprite();
        scoreBg.makeGraphic(300, 400, 0xFF000000);
        scoreBg.screenCenter(FlxAxes.Y);
        scoreBg.x = FlxG.width - scoreBg.width - 30;
        scoreBg.alpha = 0.5;
        add(scoreBg);

        songStuffTxt = new FlxText(0, 0, scoreBg.width - 20, 'Im gbv', 21);
        songStuffTxt.setFormat(Paths.font('GAU_pop_magic.ttf'), 21, 0xFFFFFFFF);
        songStuffTxt.x = scoreBg.x + 30;
        songStuffTxt.y = scoreBg.y + 130;
        add(songStuffTxt);

        difficultySpr = new FlxSprite();
        difficultySpr.loadGraphic(Paths.image('menus/freeplay/difficulties/normal'));
        difficultySpr.x = scoreBg.x + scoreBg.width / 2 - difficultySpr.width / 2;
        difficultySpr.y = scoreBg.y + 40;
        add(difficultySpr);

        albumSpr = new FlxSprite();
        albumSpr.loadGraphic(Paths.image('menus/freeplay/album'));
        albumSpr.screenCenter(FlxAxes.Y);
        albumSpr.x = 30;
        add(albumSpr);

        albumTxt = new FlxSprite();
        albumTxt.frames = Paths.getSparrowAtlas('menus/freeplay/1street-text');
        albumTxt.animation.addByPrefix('idle', 'idle', 24, false);
        albumTxt.animation.addByPrefix('switch', 'switch', 24, false);
        albumTxt.animation.play('idle');
        albumTxt.x = albumSpr.x + 45;
        albumTxt.y = albumSpr.y + albumSpr.height - 42;
        add(albumTxt);

        freeplaySongsGrp = new FlxTypedGroup();
        add(freeplaySongsGrp);

        for(num => song in freeplaySongsArr)
        {
            var songSpr = new SongItem();
            songSpr.loadGraphic(Paths.image('menus/freeplay/songs/' + song[0]));
            songSpr.ID = num;
            //songSpr.x = (shaderBg.width / 2) - (songSpr.width / 2);
            songSpr.screenCenter(FlxAxes.X);
            songSpr.startFromPoint.insert(1, (FlxG.height / 2) - (songSpr.height / 2));
            songSpr.distancePerItem = [0, 720 / 1.8];
            songSpr.targetY = num;
            songSpr.antialiasing = true;

            songSpr.songName = song[0];
            songSpr.artist = song[1];
            songSpr.snapToPosition();

            freeplaySongsGrp.add(songSpr);
        }

        upArrow = new FlxSprite();
        upArrow.loadGraphic(Paths.image('menus/freeplay/arrow'));
        //upArrow.x = shaderBg.x + (shaderBg.width / 2) - (upArrow.width / 2);
        upArrow.flipY = true;
        upArrow.screenCenter(FlxAxes.X);
        upArrow.y = 90;
        add(upArrow);

        downArrow = new FlxSprite();
        downArrow.loadGraphic(Paths.image('menus/freeplay/arrow'));
        //downArrow.x = shaderBg.x + (shaderBg.width / 2) - (downArrow.width / 2);
        downArrow.screenCenter(FlxAxes.X);
        downArrow.y = FlxG.height - downArrow.height - 90;
        add(downArrow);

        polo = new FlxSprite();
        polo.loadGraphic(Paths.image('menus/freeplay/polo'));
        add(polo);

        changeSelect();

        if(stickerSubState != null)
        {
            this.persistentUpdate = true;
            this.persistentDraw = true;

            openSubState(stickerSubState);
            stickerSubState.degenStickers();
        }
    }

    var curSelected:Int = 0;
    var curSelectedDiff:Int = 0;
    override function update(elapsed:Float)
    {
        super.update(elapsed);

        #if mobile
        handleInputs(true);
        #else
        handleInputs(false);
        #end
    }

    function handleInputs(isMobile:Bool = false)
    {
        if(isMobile)
        {
            if(TouchUtil.overlaps(upArrow))
            {
                if(TouchUtil.justPressed) changeSelect(-1);
            }

            if(TouchUtil.overlaps(downArrow))
            {
                if(TouchUtil.justPressed) changeSelect(1);
            }

            if(TouchUtil.overlaps(freeplaySongsGrp.members[curSelected]))
            {
                if(TouchUtil.justPressed)
                {
                    if(!canGoToSong) return;
                    //if(SwipeUtil.swipeAny) return;

                    var targetSong = freeplaySongsGrp.members[curSelected].songName;
                    var song:Null<Song> = SongRegistry.instance.fetchEntry(targetSong);

                    Paths.setCurrentLevel('tralala');

                    PlayStatePlaylist.isStoryMode = false;
                    PlayStatePlaylist.campaignId = null;

                    LoadingState.loadPlayState(
                      {
                        targetSong: song,
                        targetDifficulty: 'hard',
                      }, true);
                }
            }
        }
        else
        {
            if(controls.UI_UP_P)
            {
                changeSelect(-1);
            }

            if(controls.UI_DOWN_P)
            {
                changeSelect(1);
            }

            if(controls.UI_LEFT_P)
            {
                changeDiff(-1);
            }

            if(controls.UI_RIGHT_P)
            {
                changeDiff(1);
            }

            if(controls.ACCEPT)
            {
                var targetSong = freeplaySongsGrp.members[curSelected].songName;
                var song:Null<Song> = SongRegistry.instance.fetchEntry(targetSong);

                Paths.setCurrentLevel('tralala');

                PlayStatePlaylist.isStoryMode = false;
                PlayStatePlaylist.campaignId = null;

                LoadingState.loadPlayState(
                  {
                    targetSong: song,
                    targetDifficulty: 'hard',
                  }, true);
            }

            if(controls.BACK)
            {
                FlxG.switchState(new BilletesMainMenuState());
            }
        }
    }

    var canGoToSong:Bool = true;
    function changeSelect(change:Float = 0)
    {
        curSelected = FlxMath.wrap(curSelected + change, 0, freeplaySongsArr.length - 1);
        canGoToSong = false;

        if(change > 0)
        {
            FlxTween.cancelTweensOf(downArrow);
            downArrow.scale.set(1.05, 1.05);
            FlxTween.tween(downArrow, {"scale.x": 1, "scale.y": 1}, 0.6, {ease: FlxEase.quartOut});
        }
        else
        {
            FlxTween.cancelTweensOf(upArrow);
            upArrow.scale.set(1.05, 1.05);
            FlxTween.tween(upArrow, {"scale.x": 1, "scale.y": 1}, 0.6, {ease: FlxEase.quartOut});
        }

        for(num => obj in freeplaySongsGrp)
        {
            obj.targetY = num - curSelected;
            if(obj.ID == curSelected)
            {
                FlxTween.cancelTweensOf(obj);
                FlxTween.tween(obj, {alpha: 1}, 0.1);
                FlxTween.tween(obj.scale, {x: 1, y: 1}, 0.1, {onComplete: function(twn:FlxTween)
                {
                    canGoToSong = true;
                }});
            }
            else
            {
                FlxTween.cancelTweensOf(obj);
                FlxTween.tween(obj, {alpha: 0.6}, 0.1);
                FlxTween.tween(obj.scale, {x: 0.9, y: 0.9}, 0.1);
            }
        }

        var songScore:Null<Save.SaveScoreData> = Save.instance.getSongScore(freeplaySongsArr[curSelected][0], difficultiesList[curSelectedDiff], 'default');
        if(songScore != null) trace(songScore.score);
        intendedScore = songScore?.score ?? 0;

        var artist:String = freeplaySongsArr[curSelected][1];
        songStuffTxt.text = 'Best Score: \n\n$intendedScore\n\n\nSong by:\n\n$artist';
    }

    function changeDiff(change:Int = 0)
    {
        curSelectedDiff = FlxMath.wrap(curSelectedDiff + change, 0, difficultiesList.length - 1);

        difficultySpr.loadGraphic(Paths.image('menus/freeplay/difficulties/${difficultiesList[curSelectedDiff]}'));
        difficultySpr.x = scoreBg.x + scoreBg.width / 2 - difficultySpr.width / 2;
        difficultySpr.y = scoreBg.y + 40;

        changeSelect();
    }
}

class SongItem extends FlxSprite
{
    // song metadata
    public var songName:String = '';
    public var artist:String = '';

    // stuff
    public var targetY:Float = 0;
    public var startFromPoint:Array = [0, 0];
    public var distancePerItem:Array = [0, 1280];
    public function new(x:Float = 0, y:Float = 0)
    {
        super(x, y);


    }

    override function update(elapsed:Float)
    {
        super.update(elapsed);

        y = FlxMath.lerp(y, (distancePerItem[1] * targetY) + startFromPoint[1], elapsed * 10);
    }

    public function snapToPosition()
    {
        y = distancePerItem[1] * targetY + startFromPoint[1];
    }
}