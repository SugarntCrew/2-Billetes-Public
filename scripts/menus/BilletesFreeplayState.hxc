package billetes.menus;

import funkin.modding.module.Module;
import funkin.ui.ScriptedMusicBeatState;
import funkin.ui.freeplay.FreeplayState;
import funkin.play.PlayStatePlaylist;
import funkin.data.song.SongRegistry;
import funkin.play.song.Song;
import funkin.Paths;
import funkin.audio.FunkinSound;
import funkin.Preferences;
import funkin.util.Constants;
import funkin.ui.transition.LoadingState;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.addons.display.FlxBackdrop;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.text.FlxText;
import flixel.text.FlxBitmapText;
import flixel.text.FlxTextBorderStyle;
import flixel.util.FlxColor;
import flixel.math.FlxPoint;
import flixel.math.FlxMath;
import flixel.util.FlxTimer;
import flixel.group.FlxTypedGroup;
import flixel.graphics.frames.FlxBitmapFont;
import funkin.util.TouchUtil;
import funkin.util.SwipeUtil;
import funkin.ui.transition.stickers.StickerSubState;
import funkin.modding.module.ModuleHandler;
import funkin.save.Save;
import flixel.util.FlxAxes;
import funkin.ui.FullScreenScaleMode;

import flixel.addons.transition.FlxTransitionableState;

class BilletesFreeplayState extends ScriptedMusicBeatState
{
    var paperBg:FlxSprite;
    var gradient:FlxSprite;
    var blackAfterSong:FlxSprite;
    var whiteFlash:FlxSprite;
    var scoreBg:FlxSprite;
    var songStuffTxt:FlxText;
    var difficultySpr:FlxSprite;
    var albumSpr:FlxSprite;
    var albumTxt:FlxSprite;
    var freeplaySongsArr:Array<Dynamic> = [
        ['tralala', 'JabaNSL', true, 'CloudyWave ft. JabaNSL'],
        ['bruh', 'gBv2209', true, 'EliAnima'],
        ['ruby', 'Snowlui'],
        ['aura', 'EliAnima'],
        ['chabal', 'CloudyWave'],
        ['respect', 'CloudyWave ft. Snowlui'],
        ['maderistic', 'gBv2209']
    ];
    var difficultiesList:Array<String> = [
        'easy',
        'normal',
        'hard',
        'monedas',
        'billetes'
    ];
    var upArrow:FlxSprite;
    var downArrow:FlxSprite;
    var leftArrow:FlxSprite;
    var rightArrow:FlxSprite;
    var polo:FlxSprite;

    var freeplaySongsGrp:FlxTypedGroup;
    var stickerSubState:StickerSubState = null;
    
    var blackBgTrans:FlxSprite;

    public function new(?sticker:StickerSubState = null)
    {
        stickerSubState = sticker;
        super("BilletesFreeplayState");
    }

    var freeplayHandler:Module;

    override function create()
    {
        super.create();

        FlxTransitionableState.skipNextTransIn = true;
        FlxTransitionableState.skipNextTransOut = true;

        FunkinSound.playMusic('freakyMenu', {
            startingVolume: 1.0,
            overrideExisting: false,
            restartTrack: false,
            // Continue playing this music between states, until a different music track gets played.
            persist: true
        });

        freeplayHandler = ModuleHandler.getModule('BilletesFreeplayHandler');

        var handler = ModuleHandler.getModule('BilletesHandler');
        if(handler != null)
        {
            trace('Setting handler varaible to ${handler.onForcedStickerTransition}');
            handler.onForcedStickerTransition = false;
            trace('Setting handler varaible to ${handler.onForcedStickerTransition}');
        }

        FlxG.mouse.visible = !FlxG.onMobile;

        paperBg = new FlxSprite();
        paperBg.frames = Paths.getSparrowAtlas('menus/freeplay/paPER');
        paperBg.animation.addByPrefix('idle', 'papa');
        paperBg.animation.play('idle');
        paperBg.x = FlxG.width - paperBg.width;
        paperBg.antialiasing = true;
        paperBg.screenCenter();
        paperBg.scale.set(1.3, 1.3);
        add(paperBg);

        gradient = new FlxSprite();
        gradient.loadGraphic(Paths.image('menus/freeplay/gradient'));
        gradient.x = FlxG.width - gradient.width;
        gradient.antialiasing = true;
        gradient.scale.set(1.3, 1);
        gradient.screenCenter();
        add(gradient);

        blackAfterSong = new FlxSprite();
        blackAfterSong.makeGraphic(FlxG.width * 2, FlxG.height * 2, 0xFF000000);
        blackAfterSong.screenCenter();
        blackAfterSong.alpha = 0;
        add(blackAfterSong);

        whiteFlash = new FlxSprite();
        whiteFlash.makeGraphic(FlxG.width * 2, FlxG.height * 2, 0xFFFFFFFF);
        whiteFlash.screenCenter();
        whiteFlash.alpha = 0;
        add(whiteFlash);

        var scoreBgOffset:Float = 80 * (FullScreenScaleMode.wideScale.x - 1) / 0.25;
        scoreBg = new FlxSprite();
        scoreBg.makeGraphic(300, 400, 0xFF000000);
        scoreBg.screenCenter(FlxAxes.Y);
        scoreBg.x = FlxG.width - scoreBg.width - 30 - scoreBgOffset;
        scoreBg.alpha = 0.5;
        add(scoreBg);

        songStuffTxt = new FlxText(0, 0, scoreBg.width - 20, 'Im gbv', 21);
        songStuffTxt.setFormat(Paths.font('GAU_pop_magic.ttf'), 21, 0xFFFFFFFF);
        songStuffTxt.x = scoreBg.x + 30;
        songStuffTxt.y = scoreBg.y + 130;
        add(songStuffTxt);

        difficultySpr = new FlxSprite();
        difficultySpr.loadGraphic(Paths.image('menus/freeplay/difficulties/normal'));
        difficultySpr.x = scoreBg.x + scoreBg.width / 2 - difficultySpr.width / 2;
        difficultySpr.y = scoreBg.y + 40;
        add(difficultySpr);

        var albumOffset:Float = 80 * (FullScreenScaleMode.wideScale.x - 1) / 0.25;
        albumSpr = new FlxSprite();
        albumSpr.loadGraphic(Paths.image('menus/freeplay/album'));
        albumSpr.screenCenter(FlxAxes.Y);
        albumSpr.x = 30 + albumOffset;
        add(albumSpr);

        albumTxt = new FlxSprite();
        albumTxt.frames = Paths.getSparrowAtlas('menus/freeplay/1street-text');
        albumTxt.animation.addByPrefix('idle', 'idle', 24, false);
        albumTxt.animation.addByPrefix('switch', 'switch', 24, false);
        albumTxt.animation.play('idle');
        albumTxt.x = albumSpr.x + 45;
        albumTxt.y = albumSpr.y + albumSpr.height - 42;
        add(albumTxt);

        freeplaySongsGrp = new FlxTypedGroup();
        add(freeplaySongsGrp);

        for(num => song in freeplaySongsArr)
        {
            var songSpr = new SongItem();
            songSpr.loadGraphic(Paths.image('menus/freeplay/songs/' + song[0]));
            songSpr.ID = num;
            //songSpr.x = (shaderBg.width / 2) - (songSpr.width / 2);
            songSpr.screenCenter(FlxAxes.X);
            songSpr.startFromPoint.insert(1, (FlxG.height / 2) - (songSpr.height / 2));
            songSpr.distancePerItem = [0, 720 / 1.8];
            songSpr.targetY = num;
            songSpr.antialiasing = true;

            songSpr.songName = song[0];
            songSpr.artist = song[1];
            songSpr.hasChillMix = song[2];
            songSpr.snapToPosition();

            freeplaySongsGrp.add(songSpr);
        }

        upArrow = new FlxSprite();
        upArrow.loadGraphic(Paths.image('menus/freeplay/arrow'));
        //upArrow.x = shaderBg.x + (shaderBg.width / 2) - (upArrow.width / 2);
        upArrow.flipY = true;
        upArrow.screenCenter(FlxAxes.X);
        upArrow.y = 90;
        add(upArrow);

        downArrow = new FlxSprite();
        downArrow.loadGraphic(Paths.image('menus/freeplay/arrow'));
        //downArrow.x = shaderBg.x + (shaderBg.width / 2) - (downArrow.width / 2);
        downArrow.screenCenter(FlxAxes.X);
        downArrow.y = FlxG.height - downArrow.height - 90;
        add(downArrow);

        leftArrow = new FlxSprite();
        leftArrow.loadGraphic(Paths.image('menus/freeplay/diffArrow'));
        leftArrow.antialiasing = true;
        leftArrow.flipX = true;
        leftArrow.x = scoreBg.x - leftArrow.width - 2;
        add(leftArrow);

        rightArrow = new FlxSprite();
        rightArrow.loadGraphic(Paths.image('menus/freeplay/diffArrow'));
        rightArrow.antialiasing = true;
        rightArrow.x = scoreBg.x + scoreBg.width + 2;
        add(rightArrow);

        polo = new FlxSprite();
        polo.loadGraphic(Paths.image('menus/freeplay/polo'));
        polo.screenCenter();
        add(polo);

        changeSelect();
        changeDiff();
        
        #if mobile
            addBackButton(FlxG.width - 230, FlxG.height - 200, FlxColor.WHITE, () -> {
                goBack(0.001);
            }, 1.0);
        #end
        
        blackBgTrans = new FlxSprite().makeGraphic(FlxG.width, FlxG.height, 0xFF000000);
        blackBgTrans.alpha = 1;
        add(blackBgTrans);

        FlxG.camera.zoom = 1.3;
        FlxTween.tween(FlxG.camera, {zoom: 1}, 0.8, {ease: FlxEase.quartOut});
        FlxTween.tween(blackBgTrans, {alpha: 0}, 0.8, {ease: FlxEase.quartOut});

        if(stickerSubState != null)
        {
            this.persistentUpdate = true;
            this.persistentDraw = true;

            openSubState(stickerSubState);
            stickerSubState.degenStickers();
        }
    }

    var canInteract:Bool = true;
    override function update(elapsed:Float)
    {
        super.update(elapsed);

        #if mobile
        handleInputs(true);
        #else
        handleInputs(false);
        #end
    }

    var canGoBack:Bool = true;
    function handleInputs(isMobile:Bool = false)
    {
        if(!canInteract) return;

        if(isMobile)
        {
            if(TouchUtil.overlaps(upArrow))
            {
                if(TouchUtil.justPressed) 
                {
                    changeSelect(-1);
                    changeDiff();
                }
            }

            if(TouchUtil.overlaps(downArrow))
            {
                if(TouchUtil.justPressed) 
                {
                    changeSelect(1);
                    changeDiff();
                }
            }

            if(TouchUtil.overlaps(leftArrow))
            {
                if(TouchUtil.justPressed)
                {
                    changeDiff(-1);
                }
            }

            if(TouchUtil.overlaps(rightArrow))
            {
                if(TouchUtil.justPressed)
                {
                    changeDiff(1);
                }
            }

            if(TouchUtil.overlaps(freeplaySongsGrp.members[freeplayHandler.curSelected]))
            {
                if(TouchUtil.justPressed)
                {
                    goToSong(true);
                }
            }

            if(SwipeUtil.swipeLeft)
            {
                changeDiff(-1);
                changeDiff();
            }

            if(SwipeUtil.swipeRight)
            {
                changeDiff(1);
                changeDiff();
            }
        }
        else
        {
            if(controls.UI_UP_P)
            {
                changeSelect(-1);
                changeDiff();
            }

            if(controls.UI_DOWN_P)
            {
                changeSelect(1);
                changeDiff();
            }

            if(controls.UI_LEFT_P)
            {
                changeDiff(-1);
            }

            if(controls.UI_RIGHT_P)
            {
                changeDiff(1);
            }

            if(controls.ACCEPT && !stopSpamming)
            {
                stopSpamming = true;
                canInteract = false;
                goToSong(false);
            }

            if(controls.BACK && canGoBack)
            {
                goBack(0.3);
                canInteract = false;
                canGoBack = false;
            }
        }
    }

    var stopSpamming:Bool = false;

    function goToSong(mobile:Bool)
    {
        if(!canGoToSong && mobile) return;
        
        var duration:Float = 1.1;
        FlxG.sound.play(Paths.sound('confirmMenu'), 0.7);
        FlxG.sound.music.fadeOut(duration, 0);

        FlxTween.cancelTweensOf(freeplaySongsGrp.members[freeplayHandler.curSelected]);
        freeplaySongsGrp.members[freeplayHandler.curSelected].scale.set(1.05, 1.05);
        FlxTween.tween(freeplaySongsGrp.members[freeplayHandler.curSelected], {"scale.x": 1, "scale.y": 1}, duration * 0.4, {ease: FlxEase.quartOut});

        blackAfterSong.alpha = 0.45;
        whiteFlash.alpha = 1;
        FlxTween.tween(whiteFlash, {alpha: 0}, duration, {ease: FlxEase.quartOut});

        FlxTween.tween(FlxG.camera, {zoom: 1.3}, duration, {ease: FlxEase.quartIn});
        FlxTween.tween(blackBgTrans, {alpha: 1}, duration, {ease: FlxEase.quartIn, onComplete: function(twn:FlxTween)
        {
            loadSong();
        }});
    }

    function loadSong()
    {
        var targetSong = freeplaySongsGrp.members[freeplayHandler.curSelected].songName;
        var song:Null<Song> = SongRegistry.instance.fetchEntry(targetSong);

        Paths.setCurrentLevel('tralala');

        PlayStatePlaylist.isStoryMode = false;
        PlayStatePlaylist.campaignId = null;

        LoadingState.loadPlayState(
        {
            targetSong: song,
            targetDifficulty: difficultiesList[freeplayHandler.curSelectedDiff],
            targetVariation: getVariation(),
            targetInstrumental: getInstVar()
        }, true);
    }

    function goBack(time:Float)
    {
        FunkinSound.playOnce(Paths.sound('cancelMenu'), 0.7);
        FlxTween.tween(FlxG.camera, {zoom: 1.3}, 0.8, {ease: FlxEase.quartIn});
        FlxTween.tween(blackBgTrans, {alpha: 1}, 0.8, {ease: FlxEase.quartIn, onComplete: function(twn:FlxTween)
        {
            FlxG.switchState(new BilletesMainMenuState());
        }});
    }

    var canGoToSong:Bool = true;
    function changeSelect(change:Float = 0)
    {
        freeplayHandler.curSelected = FlxMath.wrap(freeplayHandler.curSelected + change, 0, freeplaySongsArr.length - 1);
        canGoToSong = false;

        if(change > 0)
        {
            FlxTween.cancelTweensOf(downArrow);
            downArrow.scale.set(1.05, 1.05);
            FlxTween.tween(downArrow, {"scale.x": 1, "scale.y": 1}, 0.6, {ease: FlxEase.quartOut});
        }
        else
        {
            FlxTween.cancelTweensOf(upArrow);
            upArrow.scale.set(1.05, 1.05);
            FlxTween.tween(upArrow, {"scale.x": 1, "scale.y": 1}, 0.6, {ease: FlxEase.quartOut});
        }

        if(change != 0) FunkinSound.playOnce(Paths.sound('scrollMenu'), 0.7);

        for(num => obj in freeplaySongsGrp)
        {
            obj.targetY = num - freeplayHandler.curSelected;
            if(obj.ID == freeplayHandler.curSelected)
            {
                FlxTween.cancelTweensOf(obj);
                FlxTween.tween(obj, {alpha: 1}, 0.1);
                FlxTween.tween(obj.scale, {x: 1, y: 1}, 0.1, {onComplete: function(twn:FlxTween)
                {
                    canGoToSong = true;
                }});
            }
            else
            {
                FlxTween.cancelTweensOf(obj);
                FlxTween.tween(obj, {alpha: 0.6}, 0.1);
                FlxTween.tween(obj.scale, {x: 0.9, y: 0.9}, 0.1);
            }
        }

        var songScore:Null<Int> = Save.instance.modOptions.get("billetesSongScores").get('${freeplaySongsArr[freeplayHandler.curSelected][0]}-${difficultiesList[freeplayHandler.curSelectedDiff]}');
        intendedScore = songScore ?? 0;

        // if(songScore != null) trace('IM NOT NULL IM HEREEE');

        var artist:String = getVariation() == 'chill' ? freeplaySongsArr[freeplayHandler.curSelected][3] : freeplaySongsArr[freeplayHandler.curSelected][1];
        songStuffTxt.text = 'Best Score: \n\n$intendedScore\n\n\nSong by:\n\n$artist';
    }

    function getVariation():String
    {
        return switch(difficultiesList[freeplayHandler.curSelectedDiff])
        {
            case 'easy': 'default';
            case 'normal': 'default';
            case 'hard': 'default';
            case 'monedas': 'chill';
            case 'billetes': 'chill';
        }
    }

    function getInstVar():String 
    {
        return switch(difficultiesList[freeplayHandler.curSelectedDiff])
        {
            case 'easy': '';
            case 'normal': '';
            case 'hard': '';
            case 'monedas': 'chill';
            case 'billetes': 'chill';
        }
    }

    function changeDiff(change:Int = 0)
    {
        freeplayHandler.curSelectedDiff = FlxMath.wrap(freeplayHandler.curSelectedDiff + change, 0, difficultiesList.length - (freeplaySongsGrp.members[freeplayHandler.curSelected].hasChillMix ? 1 : 3));

        difficultySpr.loadGraphic(Paths.image('menus/freeplay/difficulties/${difficultiesList[freeplayHandler.curSelectedDiff]}'));
        difficultySpr.x = scoreBg.x + scoreBg.width / 2 - difficultySpr.width / 2;
        difficultySpr.y = scoreBg.y + 40;

        leftArrow.y = rightArrow.y = difficultySpr.y;
        
        if(change > 0)
        {
            FlxTween.cancelTweensOf(rightArrow);
            rightArrow.scale.set(1.05, 1.05);
            FlxTween.tween(rightArrow, {"scale.x": 1, "scale.y": 1}, 0.6, {ease: FlxEase.quartOut});
        }
        else if(change < 0)
        {
            FlxTween.cancelTweensOf(leftArrow);
            leftArrow.scale.set(1.05, 1.05);
            FlxTween.tween(leftArrow, {"scale.x": 1, "scale.y": 1}, 0.6, {ease: FlxEase.quartOut});
        }

        if(change != 0) 
        {
            FunkinSound.playOnce(Paths.sound('scrollMenu'), 0.7);
            changeSelect();
        }
    }
}

class SongItem extends FlxSprite
{
    // song metadata
    public var songName:String = '';
    public var artist:String = '';
    public var hasChillMix:Bool = false;

    // stuff
    public var targetY:Float = 0;
    public var startFromPoint:Array = [0, 0];
    public var distancePerItem:Array = [0, 1280];
    public function new(x:Float = 0, y:Float = 0)
    {
        super(x, y);


    }

    override function update(elapsed:Float)
    {
        super.update(elapsed);

        y = FlxMath.lerp(y, (distancePerItem[1] * targetY) + startFromPoint[1], elapsed * 10);
    }

    public function snapToPosition()
    {
        y = distancePerItem[1] * targetY + startFromPoint[1];
    }
}