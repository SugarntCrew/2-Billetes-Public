package billetes.menus;

import funkin.Conductor;
import funkin.Paths;
import funkin.ui.ScriptedMusicBeatState;
import funkin.audio.FunkinSound;
import flixel.util.FlxTimer;
import flixel.util.FlxColor;
import funkin.graphics.FunkinSprite;
import flixel.group.FlxGroup;
import funkin.ui.AtlasText;
import funkin.util.HapticUtil;
import funkin.util.TouchUtil;
import funkin.util.SwipeUtil;
import funkin.FunkinMemory;
import flixel.addons.display.FlxBackdrop;
import flixel.util.FlxAxes;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import openfl.display.BlendMode;
import funkin.modding.module.ModuleHandler;

class BilletesTitleState extends ScriptedMusicBeatState
{
    var initialized:Bool = false;
    var credGroup:FlxGroup;
    var blackScreen:FunkinSprite;
    var ngSpr:FunkinSprite;
    var textGroup:FlxGroup;

    // title stuff
    var background:FunkinSprite;
    var circlea:FlxBackdrop;
    var logo:FunkinSprite;
    var waves:FunkinSprite;
    var waves2:FunkinSprite;
    var disc:FunkinSprite;
    var disc2:FunkinSprite;
    var front:FunkinSprite;

    public function new()
    {
        super("BilletesTitleState");
    }

    override function create()
    {
        initialized = ModuleHandler.getModule('BilletesHandler').initializedTitle;
        if (!initialized) new FlxTimer().start(1, function(tmr:FlxTimer)
        {
            startIntro();
        });
        else
            startIntro();
    }
    
    function startIntro()
    {
        if (!initialized || FlxG.sound.music == null) playMenuMusic();

        persistentUpdate = true;

        var bg:FunkinSprite = new FunkinSprite(-1).makeSolidColor(FlxG.width + 2, FlxG.height, FlxColor.BLACK);
        bg.screenCenter();
        add(bg);

        background = new FunkinSprite();
        background.loadGraphic(Paths.image('menus/titlemenu/bg'));
        add(background);

        circlea = new FlxBackdrop(Paths.image('menus/titlemenu/circlea'));
	    circlea.color = 0xFF9527F5;
	    circlea.visible = true;
        circlea.velocity.set(20, 20);
	    circlea.antialiasing = false;
        circlea.blend = BlendMode.ADD;
        add(circlea);

        logo = new FunkinSprite();
        logo.loadGraphic(Paths.image('menus/titlemenu/logo'));
        logo.scale.set(0.325, 0.325);
        logo.updateHitbox();
        logo.screenCenter();
        logo.x = logo.x - 30;
        logo.visible = true;
        logo.antialiasing = true;
        add(logo);
        
        waves = new FlxBackdrop(Paths.image('menus/titlemenu/waves'), FlxAxes.X);
        waves.blend = BlendMode.ADD;
        waves.y = 50;
        waves.velocity.x = -10;
        add(waves);

        waves2 = new FlxBackdrop(Paths.image('menus/titlemenu/waves'), FlxAxes.X);
        waves2.blend = BlendMode.ADD;
        waves2.y = FlxG.height - waves.height -50;
        waves2.velocity.x = 10;
        add(waves2);

        disc = new FunkinSprite().loadGraphic(Paths.image('menus/titlemenu/disc'));
        disc.x = -50;
        disc.y = -50;
        add(disc);

        disc2 = new FunkinSprite().loadGraphic(Paths.image('menus/titlemenu/disc'));
        disc2.x = FlxG.width - disc2.width +50;
        disc2.y = FlxG.height - disc2.height +50;
        add(disc2);

        front = new FunkinSprite().loadGraphic(Paths.image('menus/titlemenu/thing'));
        front.screenCenter();
        add(front);

        if(!initialized)
        {
            credGroup = new FlxGroup();
            add(credGroup);
        }

        textGroup = new FlxGroup();

        blackScreen = bg.clone();

        ngSpr = new FunkinSprite(0, FlxG.height * 0.52);

        if (FlxG.random.bool(1))
        {
            ngSpr.loadGraphic(Paths.image('newgrounds_logo_classic'));
        }
        else if (FlxG.random.bool(30))
        {
            ngSpr.loadGraphic(Paths.image('newgrounds_logo_animated'), true, 600);
            ngSpr.animation.add('idle', [0, 1], 4);
            ngSpr.animation.play('idle');
            ngSpr.setGraphicSize(Std.int(ngSpr.width * 0.55));
            ngSpr.y += 25;
        }
        else
        {
            ngSpr.loadGraphic(Paths.image('newgrounds_logo'));
            ngSpr.setGraphicSize(Std.int(ngSpr.width * 0.8));
        }

        ngSpr.visible = false;

        if (credGroup != null)
        {
          credGroup.add(blackScreen);
          credGroup.add(ngSpr);
          credGroup.add(textGroup);
        }

        ngSpr.updateHitbox();
        ngSpr.screenCenter(FunkinSprite.X);

        FlxG.mouse.visible = false;

        trace('INIT IS $initialized');
        if (initialized) skipIntro();
        else 
        {
            ModuleHandler.getModule('BilletesHandler').initializedTitle = true;
            initialized = true;
        }
    }

    var transitioning:Bool = false;
    var superLastBeat:Int = 0;
    override function update(elapsed:Float)
    {
        super.update(elapsed);

        if(disc != null) disc.angle += 20 * FlxG.elapsed;
        if(disc2 != null) disc2.angle += 20 * FlxG.elapsed;

        Conductor.instance.update();
        if (FlxG.sound.music != null) Conductor.instance.update(FlxG.sound.music.time);

        var pressedEnter:Bool = FlxG.keys.justPressed.ENTER #if mobile || (TouchUtil.justReleased && !SwipeUtil.justSwipedAny) #end;

        var gamepad:FlxGamepad = FlxG.gamepads.lastActive;

        if (gamepad != null)
        {
            if (gamepad.justPressed.START || gamepad.justPressed.ACCEPT) pressedEnter = true;
        }
        
        // If you spam Enter, we should skip the transition.
        if (pressedEnter && transitioning && skippedIntro)
        {
            moveToMainMenu();
        }

        if (pressedEnter && !transitioning && skippedIntro)
        {
            if (FlxG.sound.music != null) FlxG.sound.music.onComplete = null;
            //titleText.animation.play('press');
            FlxG.camera.zoom = 1.2;
            FlxTween.tween(FlxG.camera, {zoom: 1}, 1.2, {ease: FlxEase.quadOut});
            FlxG.camera.flash(FlxColor.WHITE, 1);
            FunkinSound.playOnce(Paths.sound('confirmMenu'), 0.7);
            transitioning = true;
            circlea.color = 0xFF1fcd4d;

            #if FEATURE_HAPTICS
            HapticUtil.vibrate(0.1, 0.5, 0.5);
            #end

            new FlxTimer().start(2, function(tmr:FlxTimer)
            {
                moveToMainMenu();
            });
        }

        if (pressedEnter && !skippedIntro && initialized) skipIntro();

        if ((FlxG.sound.music?.volume ?? 1.0) < 0.8 && initialized)
        {
            FlxG.sound.music.volume += 0.5 * elapsed;
        }

        //trace(Conductor.instance.currentBeat);
        if(superLastBeat != Conductor.instance.currentBeat)
        {
            superLastBeat = Conductor.instance.currentBeat;
            onSuperBeatHit();
        }
    }

    function moveToMainMenu():Void
    {
        FunkinMemory.purgeCache();
        FlxG.switchState(() -> new BilletesMainMenuState());
    }

    function playMenuMusic():Void
    {
        var shouldFadeIn:Bool = (FlxG.sound.music == null);
        // Load music. Includes logic to handle BPM changes.
        FunkinSound.playMusic('freakyMenu', {
        startingVolume: 0.0,
        overrideExisting: true,
        restartTrack: false,
        // Continue playing this music between states, until a different music track gets played.
        persist: true
        });
        // Fade from 0.0 to 1 over 4 seconds
        if (shouldFadeIn) FlxG.sound.music.fadeIn(4.0, 0.0, 1.0);
    }

    function createCoolText(textArray:Array<String>):Void
    {
        if (credGroup == null || textGroup == null) return;

        for (i in 0...textArray.length)
        {
        var money:AtlasText = new AtlasText(0, 0, textArray[i], 'bold');
        money.screenCenter(FlxAxes.X);
        money.y += (i * 60) + 200;
        // credGroup.add(money);
        textGroup.add(money);
        }
    }

    function addMoreText(text:String):Void
    {
        if (credGroup == null || textGroup == null) return;

        HapticUtil.vibrate();

        var coolText:AtlasText = new AtlasText(0, 0, text, 'bold');
        coolText.screenCenter(FlxAxes.X);
        coolText.y += (textGroup.length * 60) + 200;
        textGroup.add(coolText);
    }

    function deleteCoolText():Void
    {
        if (credGroup == null || textGroup == null) return;

        while (textGroup.members.length > 0)
        {
        // credGroup.remove(textGroup.members[0], true);
        textGroup.remove(textGroup.members[0], true);
        }
    }

    var skippedIntro:Bool = false;
    public function onSuperBeatHit():Bool
    {
        trace(Conductor.instance.currentBeat);
        
        if(logo != null)
        {
            FlxTween.cancelTweensOf(logo);
		    logo.scale.set(0.325, 0.325);
		    FlxTween.tween(logo.scale, {x: 0.3, y: 0.3}, 0.35, {ease: FlxEase.expoOut});
        }

        if(disc != null)
        {
            FlxTween.cancelTweensOf(disc);
            disc.scale.set(1.05, 1.05);
		    FlxTween.tween(disc.scale, {x: 1, y: 1}, 0.35, {ease: FlxEase.expoOut});
        }

        if(disc2 != null)
        {
            FlxTween.cancelTweensOf(disc2);
            disc2.scale.set(1.05, 1.05);
		    FlxTween.tween(disc2.scale, {x: 1, y: 1}, 0.35, {ease: FlxEase.expoOut});
        }

        if (!skippedIntro)
        {
            switch (Conductor.instance.currentBeat)
            {
                case 1:
                createCoolText(['The', 'Funkin Crew Inc']);
                case 3:
                addMoreText('presents');
                case 4:
                deleteCoolText();
                case 5:
                createCoolText(['In association', 'with']);
                case 7:
                addMoreText('newgrounds');
                if (ngSpr != null) ngSpr.visible = true;
                case 8:
                deleteCoolText();
                if (ngSpr != null) ngSpr.visible = false;
                case 9:
                createCoolText(['LOL CON LUL']);
                case 11:
                addMoreText('LUL CON LOL');
                case 12:
                deleteCoolText();
                case 13:
                addMoreText('Friday');
                case 14:
                addMoreText('Night');
                case 15:
                addMoreText('Funkin');
                case 16:
                skipIntro();
            }
        }

        if(Conductor.instance.currentBeat >= 16)
        {
            skipIntro();
        }

        return true;
    }

    function skipIntro():Void
    {
        if (!skippedIntro)
        {
            remove(ngSpr);
            
            FlxG.camera.flash(FlxColor.WHITE, initialized ? 1 : 4);
            
            if (credGroup != null) remove(credGroup);
            skippedIntro = true;
        }
    }
}