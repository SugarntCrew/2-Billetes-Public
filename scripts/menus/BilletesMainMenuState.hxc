package billetes.menus;

import funkin.modding.module.Module;
import funkin.ui.ScriptedMusicBeatState;
import funkin.ui.freeplay.FreeplayState;
import funkin.ui.options.OptionsState;
import funkin.util.TouchUtil;
import funkin.util.SwipeUtil;
import funkin.Paths;
import funkin.Preferences;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.text.FlxText;
import flixel.text.FlxBitmapText;
import flixel.text.FlxTextBorderStyle;
import flixel.util.FlxColor;
import flixel.math.FlxPoint;
import flixel.math.FlxMath;
import flixel.util.FlxTimer;
import flixel.group.FlxTypedGroup;
import flixel.graphics.frames.FlxBitmapFont;
import funkin.ui.FullScreenScaleMode;
import funkin.ui.debug.DebugMenuSubState;
import funkin.modding.module.ModuleHandler;

import flixel.addons.transition.FlxTransitionableState;

class BilletesMainMenuState extends ScriptedMusicBeatState
{
    public function new()
    {
        super("BilletesMainMenuState");
    }

    var wall:FlxSprite;
    var floor:FlxSprite;
    var bf:FlxSprite;
    var optsArray:Array = 
    [
        'options',
        'freeplay',
        'credits'
    ];
    var optsGrp:FlxTypedGroup;
    var textFollowMouseBg:FlxSprite;
    var textFollowMouse:FlxText;
    var previousBfTargetX:Float = 0;
    var bfTargetX:Float = 0;

    var blackBgTrans:FlxSprite;

    var cutoutSize:Float = 0;
    override function create()
    {
        super.create();
        
        var handler = ModuleHandler.getModule('BilletesHandler');
        if(handler != null)
        {
            trace('Setting handler varaible to ${handler.onForcedStickerTransition}');
            handler.onForcedStickerTransition = false;
            trace('Setting handler varaible to ${handler.onForcedStickerTransition}');
        }

        cutoutSize = FullScreenScaleMode.gameCutoutSize.x / 2;

        FlxG.mouse.visible = !FlxG.onMobile;

        wall = new FlxSprite();
        wall.loadGraphic(Paths.image('menus/mainmenu/wall'));
        wall.antialiasing = true;
        wall.screenCenter();
        add(wall);

        optsGrp = new FlxTypedGroup();
        add(optsGrp);

        floor = new FlxSprite();
        floor.loadGraphic(Paths.image('menus/mainmenu/floor'));
        floor.antialiasing = true;
        floor.screenCenter();
        floor.x += 0;
        add(floor);
        
        bf = new FlxSprite();
        bf.frames = Paths.getSparrowAtlas('menus/mainmenu/bf');
        bf.animation.addByPrefix('idle', 'idle');
        bf.animation.addByPrefix('walking', 'walkin', 20);
        bf.animation.play('idle');
        bf.antialiasing = true;
        bf.screenCenter(FlxSprite.Y);
        bf.y += 120;
        bf.x = FlxG.width / 2 - 100;
        add(bf);

        for(i in 0...optsArray.length)
        {
            var spr = new MainMenuItem();
            spr.frames = Paths.getSparrowAtlas('menus/mainmenu/' + optsArray[i]);
            spr.animation.addByPrefix('idle', 'puerat_' + optsArray[i] + '0');
            spr.animation.addByPrefix('selected', 'puerat_' + optsArray[i] + '_si');
            spr.animation.play('idle');
            spr.ID = i;
            spr.screenCenter(FlxSprite.Y);
            //spr.x = 45 + (i * 370);
            spr.x = cutoutSize + 45 + (i * 370);
            spr.y += 10;
            spr.antialiasing = true;
            spr.isMobileSelected = false;
            spr.labelPrompt = optsArray[i];
            spr.updateHitbox();
            optsGrp.add(spr);
        }

        optsGrp.members[0].flipX = true; //options to the far left

        optsGrp.members[2].x += 170; //credits to the far right

        textFollowMouseBg = new FlxSprite();
        textFollowMouseBg.antialiasing = true;
        add(textFollowMouseBg);

		var fontLetters:String = "0123456789abcdefghijklmnopqrstuvwxyz";
		textFollowMouse = new FlxBitmapText(0, 0, '', FlxBitmapFont.fromMonospace(Paths.image("menus/mainmenu/Alphabet_billets"), fontLetters, FlxPoint.get(44, 58)));
		textFollowMouse.scrollFactor.set(1, 1);
        //textFollowMouse = new FlxBitmapText(0, 0, 0, '', 16);
        //textFollowMouse.setFormat(Paths.font('vcr.ttf'), 16, FlxColor.WHITE, "left", FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
        textFollowMouse.y = optsGrp.members[0].y - textFollowMouse.height - 10;
        textFollowMouse.antialiasing = true;
        add(textFollowMouse);

        textFollowMouseBg.makeGraphic(textFollowMouse.width + 10, textFollowMouse.height + 10, 0xFF000000);
        textFollowMouseBg.setPosition(textFollowMouse.x - 5, textFollowMouse.y - 5);
        textFollowMouseBg.alpha = 0.55;

        #if mobile
            addBackButton(FlxG.width - 230, FlxG.height - 200, FlxColor.WHITE, () -> {
                goBack();
            }, 1.0);
        #end

        blackBgTrans = new FlxSprite().makeGraphic(FlxG.width, FlxG.height, 0xFF000000);
        blackBgTrans.alpha = 1;
        add(blackBgTrans);

        FlxG.camera.zoom = 1.3;
        FlxTween.tween(FlxG.camera, {zoom: 1}, 0.8, {ease: FlxEase.quartOut});
        FlxTween.tween(blackBgTrans, {alpha: 0}, 0.8, {ease: FlxEase.quartOut});

        FlxTransitionableState.skipNextTransIn = true;
        FlxTransitionableState.skipNextTransOut = true;
    }

	var scrollMultiplier:Float = 5;

    var alreadySelectingSomething:Bool = false;
    var curSelected:Int = 0;
    var labelPrompt:String = '';
    var scaleTween:FlxTween;
    var hudMousePos:Dynamic;

    override function update(elapsed:Float)
    {
        super.update(elapsed);

        hudMousePos = FlxG.mouse.getScreenPosition();

		var multX = (hudMousePos.x - (FlxG.width / 2)) / (FlxG.width / 2);
		var multY = (hudMousePos.y - (FlxG.height / 2)) / (FlxG.height / 2);

		FlxG.camera.scroll.x = FlxMath.lerp(FlxG.camera.scroll.x, (multX * scrollMultiplier), elapsed * 10);
		FlxG.camera.scroll.y = FlxMath.lerp(FlxG.camera.scroll.y, (multY * scrollMultiplier), elapsed * 10);

        handleInputs(FlxG.onMobile);
        //handleInputs(true);

        //textFollowMouse.setPosition(hudMousePos.x + 20, hudMousePos.y - 10);
        for(obj in optsGrp)
        {
            if(obj.ID == curSelected && obj.animation.curAnim.name == 'selected')
            {
                textFollowMouse.text = obj.labelPrompt;
                textFollowMouse.x = obj.x + (obj.width / 2) - (textFollowMouse.width / 2);
                textFollowMouseBg.visible = true;
                textFollowMouseBg.makeGraphic(textFollowMouse.width + 10, textFollowMouse.height + 10, 0xFF000000);
                textFollowMouseBg.setPosition(textFollowMouse.x - 5, textFollowMouse.y - 5);
                break;
            }
            else 
            {
                textFollowMouse.text = '';
                textFollowMouseBg.visible = false;
            }
        }

        if(controls.BACK) goBack();
    }

    function goBack()
    {
        FlxTween.tween(FlxG.camera, {zoom: 1.3}, 0.8, {ease: FlxEase.quartIn});
        FlxTween.tween(blackBgTrans, {alpha: 1}, 0.8, {ease: FlxEase.quartIn, onComplete: function(twn:FlxTween)
        {
            FlxG.switchState(() -> new BilletesTitleState());
        }});
    }

    var sprSelectedMobile:FlxSprite;
    function handleInputs(isMobile:Bool = false)
    {
        if(isMobile)
        {
            optsGrp.forEach(function(spr:MainMenuItem)
            {
                if(FlxG.mouse.justPressed)
                {
                    var objCasted:MainMenuItem = null;
                    if(spr.pixelsOverlapPoint(hudMousePos)) objCasted = spr;

                    if(objCasted != null) objCasted.isMobileSelected = true;
                    else 
                    {
                        spr.isMobileSelected = false;
                        //spr.labelPrompt = '';
                        spr.animation.play('idle');
                        if(spr.ID == optsGrp.length-1) alreadySelectingSomething = false;
                    }
                }

                if(spr.isMobileSelected)
                {
                    if(curSelected != spr.ID) alreadySelectingSomething = false;
                    if(!alreadySelectingSomething)
                    {
                        alreadySelectingSomething = true;
                        curSelected = spr.ID;
                        spr.animation.play('selected');
                        spr.labelPrompt = optsArray[curSelected];
                        bfTargetX = spr.x;
                        if(previousBfTargetX != bfTargetX)
                        {
                            bf.flipX = (bfTargetX - previousBfTargetX) > 0 ? true : false;
                            previousBfTargetX = bfTargetX;
                            bf.animation.play('walking', true);
                            FlxTween.cancelTweensOf(bf);
                            FlxTween.tween(bf, {x: bfTargetX + (spr.width / 2) - (bf.width / 2)}, 1, {ease: FlxEase.linear, onComplete: function(twn:FlxTween)
                            {
                                bf.animation.play('idle', true);
                            }});
                        }
                    }
                    else
                    {
                        if(FlxG.mouse.justPressed)
                        {
                            FlxTween.cancelTweensOf(bf);
                            FlxTween.tween(bf, {angle: 2000, y: bf.y - 150, x: bfTargetX + (spr.width / 2) - (bf.width / 2)}, 1, {ease: FlxEase.quadInOut});
                            scaleTween = FlxTween.num(1, 0, 1, {ease: FlxEase.quadInOut}, function(v:Float) { bf.scale.set(v, v); });
                            FlxTween.tween(FlxG.camera, {zoom: 1.3}, 1, {ease: FlxEase.quartIn});
                            FlxTween.tween(blackBgTrans, {alpha: 1}, 1, {ease: FlxEase.quartIn});

                            new FlxTimer().start(1, (_) -> {
                                switch(curSelected)
                                {
                                    case 0:
                                        FlxG.switchState(new OptionsState());
                                    case 1:
                                        FlxG.switchState(() -> new BilletesFreeplayState());
                                    default: //do nothing
                                }
                            });
                        }
                    }
                }
            });
        }
        else
        {
            alreadySelectingSomething = false;
            optsGrp.forEach(function(spr:MainMenuItem)
            {
                if(spr.pixelsOverlapPoint(hudMousePos))
                {
                    alreadySelectingSomething = true;
                    curSelected = spr.ID;
                    spr.animation.play('selected');
                    labelPrompt = optsArray[curSelected];
                    bfTargetX = spr.x;
                    if(previousBfTargetX != bfTargetX)
                    {
                        bf.flipX = (bfTargetX - previousBfTargetX) > 0 ? true : false;
                        previousBfTargetX = bfTargetX;
                        bf.animation.play('walking', true);
                        FlxTween.cancelTweensOf(bf);
                        FlxTween.tween(bf, {x: bfTargetX + (spr.width / 2) - (bf.width / 2)}, 1, {ease: FlxEase.linear, onComplete: function(twn:FlxTween)
                        {
                            bf.animation.play('idle', true);
                        }});
                    }
                    if(FlxG.mouse.justPressed)
                    {
                        FlxTween.cancelTweensOf(bf);
                        FlxTween.tween(bf, {angle: 2000, y: bf.y - 150, x: bfTargetX + (spr.width / 2) - (bf.width / 2)}, 1, {ease: FlxEase.quadInOut});
                        scaleTween = FlxTween.num(1, 0, 1, {ease: FlxEase.quadInOut}, function(v:Float) { bf.scale.set(v, v); });
                        FlxTween.tween(FlxG.camera, {zoom: 1.3}, 1, {ease: FlxEase.quartIn});
                        FlxTween.tween(blackBgTrans, {alpha: 1}, 1, {ease: FlxEase.quartIn});
                        new FlxTimer().start(1, (_) -> {
                            switch(curSelected)
                            {
                                case 0:
                                    FlxG.switchState(new OptionsState());
                                case 1:
                                    FlxG.switchState(new BilletesFreeplayState());
                                default: //do nothing
                            }
                        });
                    }
                }
                else
                {
                    if(!alreadySelectingSomething) labelPrompt = '';
                    spr.animation.play('idle');
                }
            });
        }

        if (controls.DEBUG_MENU)
        {
            FlxG.state.openSubState(new DebugMenuSubState());
        }
    }
}

class MainMenuItem extends FlxSprite
{
    public var isMobileSelected:Bool = false;
    public var labelPrompt:String = '';
    
    public function new(x:Float = 0, y:Float = 0)
    {
        super(x, y);
    }
}