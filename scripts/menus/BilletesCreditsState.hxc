package billetes.menus;

import funkin.ui.ScriptedMusicBeatState;
import flixel.FlxSprite;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.util.FlxEase;
import flixel.math.FlxMath;
import flixel.addons.transition.FlxTransitionableState;

class BilletesCreditsState extends ScriptedMusicBeatState
{
    public function new()
    {
        super("BilletesCreditsState");
    }

    public var curSelected:Int = 0;
    public var credits:Array = [
        {
            name: "Heromax",
            image: 'hero',
            description: 'Director and gay',
            offsets: {
                x: 20,
                y: 5
            }
        },
        {
            name: "gBv2209",
            image: 'gbv',
            description: 'Artist and autist',
            offsets: {
                x: 0,
                y: 0
            }
        },
        {
            name: "Mr. Madera",
            image: 'madera',
            description: 'I do kool stuff',
            offsets: {
                x: 0,
                y: 0
            }
        },
    ];

    var billetsBg:FlxSprite;
    var blackBgTrans:FlxSprite;
    var currentChar:FlxSprite;

    override function create()
    {
        super.create();

        billetsBg = new FlxSprite();
        //billetsBg.loadGraphic(Paths.image('menus/credits/2billetsBG'));
        billetsBg.frames = Paths.getSparrowAtlas('menus/credits/2billetsBG');
        billetsBg.animation.addByPrefix('idle', 'idle', 3, true);
        billetsBg.animation.play('idle');
        billetsBg.screenCenter();
        billetsBg.antialiasing = true;
        add(billetsBg);
        
        currentChar = new FlxSprite();
        currentChar.loadGraphic(Paths.image('menus/credits/char/${credits[curSelected].image}'));
        currentChar.antialiasing = true;
        resetChar();
        add(currentChar);

        blackBgTrans = new FlxSprite().makeGraphic(FlxG.width, FlxG.height, 0xFF000000);
        blackBgTrans.alpha = 1;
        add(blackBgTrans);

        changeSelect();

        FlxG.camera.zoom = 1.3;
        FlxTween.tween(FlxG.camera, {zoom: 1}, 0.8, {ease: FlxEase.quartOut});
        FlxTween.tween(blackBgTrans, {alpha: 0}, 0.8, {ease: FlxEase.quartOut});

        FlxTransitionableState.skipNextTransIn = true;
        FlxTransitionableState.skipNextTransOut = true;
    }

    override function update(elapsed:Float)
    {
        super.update(elapsed);

        if(controls.BACK) goBack();

        if(controls.UI_LEFT_P)
        {
            changeSelect(-1);
        }

        if(controls.UI_RIGHT_P)
        {
            changeSelect(1);
        }
    }

    function changeSelect(change:Int = 0)
    {
        curSelected = FlxMath.wrap(curSelected + change, 0, credits.length - 1);

        currentChar.loadGraphic(Paths.image('menus/credits/char/${credits[curSelected].image}'));
        if(credits[curSelected].offsets != null)
        {
            currentChar.offset.set(credits[curSelected].offsets.x, credits[curSelected].offsets.y);
        }

        FlxTween.cancelTweensOf(currentChar);

        resetChar();
        currentChar.y += 5;
        FlxTween.tween(currentChar, {y: currentChar.y - 5}, 0.3, {ease: FlxEase.quartOut});
        FlxTween.color(currentChar, 0.3, currentChar.color, 0xFFFFFFFF, {ease: FlxEase.quartOut});
    }

    function resetChar()
    {
        currentChar.screenCenter();
        currentChar.color = 0xFFCFCFCF;
        currentChar.x += 50;
    }

    function goBack()
    {
        FlxTween.tween(FlxG.camera, {zoom: 1.3}, 0.8, {ease: FlxEase.quartIn});
        FlxTween.tween(blackBgTrans, {alpha: 1}, 0.8, {ease: FlxEase.quartIn, onComplete: function(twn:FlxTween)
        {
            FlxG.switchState(() -> new BilletesMainMenuState());
        }});
    }
}