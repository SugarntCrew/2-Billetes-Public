    var billetsBg:FlxSprite;
    var currentChar:FlxSprite;
    var poloUp:FlxBackdrop;
    var poloDown:FlxBackdrop;
    var table:FlxSprite;
    var nameTag:CreditNametag;
    var descriptionText:FlxText;
    var blackBgTrans:FlxSprite;

    var rolesArr:Array = [
        'artist',
        'music',
        'coding',
        'charting',
        'animator'
    ];
    var rolesGrp:FlxTypedGroup;

    var socialsArr:Array = [
        'yt',
        'x',
        'sc'
    ];
    var socialsGrp:FlxTypedGroup;

    var rolCard:RolCard;

    override function create()
    {
        super.create();

        FunkinSound.playMusic('creditsMenu', {
            startingVolume: 0.0,
            overrideExisting: true,
            restartTrack: false,
            // Continue playing this music between states, until a different music track gets played.
            persist: false
        });

        if(FlxG.sound.music.volume < 0.1) FlxG.sound.music.fadeIn(1, 0, 1);

        billetsBg = new FlxSprite();
        //billetsBg.loadGraphic(Paths.image('menus/credits/2billetsBG'));
        billetsBg.frames = Paths.getSparrowAtlas('menus/credits/2billetsBG');
        billetsBg.animation.addByPrefix('idle', 'idle', 3, true);
        billetsBg.animation.play('idle');
        billetsBg.screenCenter();
        billetsBg.antialiasing = true;
        add(billetsBg);
        
        currentChar = new FlxSprite();
        currentChar.loadGraphic(Paths.image('menus/credits/char/${credits[curSelected].image}'));
        currentChar.antialiasing = true;
        add(currentChar);

        table = new FlxSprite();
        table.loadGraphic(Paths.image('menus/credits/table'));
        table.antialiasing = true;
        table.screenCenter();
        table.x += -(table.width / 2);
        add(table);

        nameTag = new CreditNametag(0, 0, credits[curSelected].image);
        //nameTag.loadGraphic(Paths.image('menus/credits/nametags/${credits[curSelected].image}'));
        nameTag.antialiasing = true;
        add(nameTag);

        descriptionText = new FlxText(table.x + 15, table.y + 170, table.width - 20, '');
        descriptionText.setFormat(Paths.font('Mustasurma.ttf'), 20, 0xFFFFFFFF, "center");
        descriptionText.antialiasing = true;
        add(descriptionText);

        rolesGrp = new FlxTypedGroup();
        add(rolesGrp);

        for(i in 0...rolesArr.length)
        {
            var spr = new RolObject();
            spr.loadGraphic(Paths.image('menus/credits/roles/${rolesArr[i]}'));
            spr.antialiasing = true;
            spr.updateHitbox();
            spr.x = table.x + table.width + 30 + ((i * 85));
            spr.y = table.y;
            spr.rolName = rolesArr[i];
            switch(rolesArr[i])
            {
                case 'music': spr.offset.set(-10, 0);
                case 'charting': spr.offset.set(-10, 0);
            }
            rolesGrp.add(spr);
        }
        
        resetChar();

        socialsGrp = new FlxTypedGroup();
        add(socialsGrp);

        for(i in 0...socialsArr.length)
        {
            var spr = new SocialMediaObject(currentChar.x + currentChar.width + 20, 0, socialsArr[i]);
            spr.updatePosition(currentChar.x + currentChar.width + 20, currentChar.y + 20 + (i * (spr.socialMediaSpr.height)));
            if(socialsArr[i] == 'yt') spr.updateOffsets(0, -15);

            spr.socialName = socialsArr[i];
            socialsGrp.add(spr);
        }

        var targetVelocity:Float = 20;
        poloUp = new FlxBackdrop(Paths.image('menus/credits/polo'), null, 0, 1000);
        //poloUp.loadGraphic();
        poloUp.flipY = true;
        poloUp.antialiasing = true;
        poloUp.screenCenter(FlxAxes.X);
        poloUp.velocity.set(targetVelocity, 0);
        add(poloUp);

        poloDown = new FlxBackdrop(Paths.image('menus/credits/polo'), null, 0, 1000);
        //poloDown.loadGraphic(Paths.image('menus/credits/polo'));
        poloDown.antialiasing = true;
        poloDown.screenCenter(FlxAxes.X);
        poloDown.y = FlxG.height - poloDown.height;
        poloDown.velocity.set(-targetVelocity, 0);
        add(poloDown);

        rolCard = new RolCard();
        add(rolCard);

        blackBgTrans = new FlxSprite().makeGraphic(FlxG.width, FlxG.height, 0xFF000000);
        blackBgTrans.alpha = 1;
        add(blackBgTrans);

        changeSelect();

        FlxG.camera.zoom = 1.3;
        FlxTween.tween(FlxG.camera, {zoom: 1}, 0.8, {ease: FlxEase.quartOut});
        FlxTween.tween(blackBgTrans, {alpha: 0}, 0.8, {ease: FlxEase.quartOut});

        FlxTransitionableState.skipNextTransIn = true;
        FlxTransitionableState.skipNextTransOut = true;
        
        #if mobile
            addBackButton(FlxG.width - 230, FlxG.height - 200, FlxColor.WHITE, () -> {
                goBack(0.001);
            }, 1.0);
        #end
    }

    override function update(elapsed:Float)
    {
        super.update(elapsed);

        // squishi squishi anim
        var multX = FlxMath.lerp(currentChar.scale.x, characterScaleX, elapsed * 9);
        var multY = FlxMath.lerp(currentChar.scale.y, characterScaleY, elapsed * 9);
        currentChar.scale.set(multX, multY);

        for(obj in rolesGrp)
        {
            if(FlxG.mouse.overlaps(obj))
            {
                for(memb in rolCard)
                {
                    memb.visible = true;
                    memb.setPosition(FlxG.mouse.x - rolCard.blackBg.width + 2, FlxG.mouse.y - rolCard.blackBg.height + 2);
                    rolCard.updateText(obj.rolName);
                }
                break;
            }
            else
            {
                for(memb in rolCard)
                {
                    memb.visible = false;
                }
            }
        }

        if(controls.BACK) goBack();

        if(controls.UI_LEFT_P)
        {
            changeSelect(-1);
        }

        if(controls.UI_RIGHT_P)
        {
            changeSelect(1);
        }
    }

    var characterScaleX:Float = 1;
    var characterScaleY:Float = 1;
    var squishiIntensity:Float = 0.05;
    function changeSelect(change:Int = 0)
    {
        if(change != 0) FlxG.sound.play(Paths.sound('scrollMenuBillets'));

        curSelected = FlxMath.wrap(curSelected + change, 0, credits.length - 1);

        nameTag.loadGraphic(Paths.image('menus/credits/nametags/${credits[curSelected].image}'));
        currentChar.loadGraphic(Paths.image('menus/credits/char/${credits[curSelected].image}'));
        if(credits[curSelected].offsets != null)
        {
            currentChar.offset.set(credits[curSelected].offsets.x, credits[curSelected].offsets.y);
        }
        descriptionText.text = credits[curSelected].description;
        nameTag.switchChar(credits[curSelected].image);

        FlxTween.cancelTweensOf(currentChar);
        FlxTween.cancelTweensOf(nameTag);
        FlxTween.cancelTweensOf(descriptionText);

        resetChar();

        currentChar.y += 5;
        currentChar.angle = FlxG.random.bool(50) ? 0 : 2;
        currentChar.scale.set(characterScaleX - squishiIntensity, characterScaleY + squishiIntensity);

        FlxTween.tween(currentChar, {y: currentChar.y - 5, angle: -1}, 0.3, {ease: FlxEase.quartOut, onComplete: function(twn:FlxTween)
        {
            //FlxTween.tween(currentChar, {y: currentChar.y - 3, angle: 1}, 2, {ease: FlxEase.quartInOut, type: 4});
            FlxTween.tween(currentChar, {y: currentChar.y - 4}, 2, {ease: FlxEase.smoothStepInOut, type: 4});
            FlxTween.tween(currentChar, {angle: 1}, 3, {ease: FlxEase.smootherStepInOut, type: 4});
        }});

        FlxTween.color(currentChar, 0.3, currentChar.color, 0xFFFFFFFF, {ease: FlxEase.quartOut});

        descriptionText.y += 10;
        FlxTween.tween(descriptionText, {alpha: 1, y: descriptionText.y - 10}, 0.3, {ease: FlxEase.quartOut});

        nameTag.y += 5;
        nameTag.angle = -1;
        FlxTween.tween(nameTag, {y: nameTag.y - 5}, 0.3, {ease: FlxEase.quartOut, onComplete: function(twn:FlxTween)
        {
            FlxTween.tween(nameTag, {angle: 1}, 3, {ease: FlxEase.smootherStepInOut, type: 4});
        }});

        for(memb in rolesGrp)
        {
            FlxTween.cancelTweensOf(memb);

            if(memb.onChange(credits[curSelected].roles))
            {
                FlxTween.tween(memb, {alpha: 1}, 0.3, {ease: FlxEase.quartOut});
                memb.existsRol = true;
            }
            else
            {
                FlxTween.tween(memb, {alpha: 0.6}, 0.3, {ease: FlxEase.quartOut});
                memb.existsRol = false;
            }
        }

        for(memb in socialsGrp)
        {
            memb.updateWoodVisible(!memb.onChange(credits[curSelected].socials));
        }
    }

    var charYOffset:Float = 20;
    var nametagYOffset:Float = 10;
    function resetChar()
    {
        currentChar.screenCenter();
        currentChar.color = 0xFFCFCFCF;
        currentChar.x += (table.width / 2);
        currentChar.y += (currentChar.height / 10) + charYOffset;

        // nametag stuff

        nameTag.x = table.x + table.width / 2 - nameTag.width / 2;
        nameTag.y = (table.y) + nametagYOffset;

        descriptionText.y = table.y + 170;
        descriptionText.alpha = 0;

        //for(memb in rolesGrp)
        //{
        //    memb.alpha = 1;
        //}
    }

    function goBack()
    {
        FlxG.sound.music.fadeOut(0.8, 0, (_) -> FlxG.sound.music = null);
        FlxTween.tween(FlxG.camera, {zoom: 1.3}, 0.8, {ease: FlxEase.quartIn});
        FlxTween.tween(blackBgTrans, {alpha: 1}, 0.8, {ease: FlxEase.quartIn, onComplete: function(twn:FlxTween)
        {
            FlxG.switchState(() -> new BilletesMainMenuState());
        }});
    }
}